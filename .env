# LLM Provider Configuration
# Choose one: openai, modelscope, zhipu, doubao, vllm, ollama
LLM_PROVIDER=doubao

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here

# Generic LLM Configuration (works with OpenAI-compatible APIs)
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL_ID=gpt-3.5-turbo

# ModelScope Configuration
MODELSCOPE_API_KEY=your_modelscope_api_key

# Zhipu AI Configuration
ZHIPUAI_API_KEY=your_zhipuai_api_key

# Doubao Configuration
DOUBAO_API_KEY=b1d371ef-6ef8-449e-9e03-4eda9805708b
DOUBAO_MODEL_ID=doubao-seed-1-6-251015

# VLLM Configuration
VLLM_ENDPOINT=http://127.0.0.1:8000/v1/chat/completions
VLLM_API_KEY=your_vllm_api_key

# Ollama Configuration
OLLAMA_ENDPOINT=http://127.0.0.1:11434/api/tags
OLLAMA_API_KEY=your_ollama_api_key

# TTS Configuration
TTS_PROVIDER=edge
# For Azure TTS
AZURE_TTS_KEY=your_azure_tts_key
AZURE_TTS_REGION=your_azure_region

# Other configurations...