# ASR 配置
ASR_PROVIDER=dashscope
DASHSCOPE_API_KEY=
DASHSCOPE_ASR_MODEL=qwen3-asr-flash
DASHSCOPE_AUDIO_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# LLM 配置
LLM_API_KEY=
LLM_MODEL_ID=qwen3-max
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# TTS 配置
TTS_PROVIDER=sandbox
# SOVITS_ENDPOINT=http://localhost:8000
# SOVITS_PUBLIC_BASE=http://localhost:8000
# SOVITS_APP_KEY=
# SOVITS_DOWNLOAD_URL=

# WebRTC ICE 服务器配置
# STUN 服务器用于 NAT 穿透（可以使用 Google 的公开服务器）
STUN_SERVER=stun:stun.l.google.com:19302

# TURN 服务器用于中继（生产环境建议自建 coturn）
# TURN_SERVER=turn:your-turn-server.com:3478
# TURN_USERNAME=your-username
# TURN_CREDENTIAL=your-password

# ================================
# Qdrant 向量数据库配置 - 获取API密钥：https://cloud.qdrant.io/
# ================================
# 使用Qdrant云服务 (推荐)
QDRANT_URL=
QDRANT_API_KEY=

# 或使用本地Qdrant (需要Docker)
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=

# Qdrant集合配置
QDRANT_COLLECTION=
QDRANT_VECTOR_SIZE=
QDRANT_DISTANCE=
QDRANT_TIMEOUT=

# ================================
# Neo4j 图数据库配置 - 获取API密钥：https://neo4j.com/cloud/aura/
# ================================
# 使用Neo4j Aura云服务 (推荐)
NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=

# 或使用本地Neo4j (需要Docker)
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USERNAME=neo4j
# NEO4J_PASSWORD=password

# Neo4j连接配置
NEO4J_DATABASE=neo4j
NEO4J_MAX_CONNECTION_LIFETIME=3600
NEO4J_MAX_CONNECTION_POOL_SIZE=50
NEO4J_CONNECTION_TIMEOUT=60

# ==========================
# 嵌入（Embedding）配置示例 - 可从阿里云控制台获取：https://dashscope.aliyun.com/
# ==========================
# - 若为空，dashscope 默认 text-embedding-v3；local 默认 sentence-transformers/all-MiniLM-L6-v2
EMBED_MODEL_TYPE=dashscope
EMBED_MODEL_NAME=text-embedding-v3
EMBED_API_KEY=
EMBED_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1